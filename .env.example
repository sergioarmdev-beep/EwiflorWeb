

APP_NAME=EwiflorWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# HTTPS
# Activar únicamente cuando se utilice HTTPS.
FORCE_HTTPS=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# =====================================================================
# LOGS
# =====================================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =====================================================================
# BASE DE DATOS — PostgreSQL
# =====================================================================

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=Ewiflor_DB_MVP
DB_USERNAME=ewiflor_app
DB_PASSWORD=

# Usuario de migraciones
DB_MIGRATOR_USERNAME=ewiflor_migrator
DB_MIGRATOR_PASSWORD=


DB_AUTH_USERNAME=ewiflor_auth
DB_AUTH_PASSWORD=


DB_BACKUP_USERNAME=ewiflor_backup
DB_BACKUP_PASSWORD=

# =====================================================================
# SESIONES
# =====================================================================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =====================================================================
# CACHE, COLAS Y ARCHIVOS
# =====================================================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# =====================================================================
# REDIS
# =====================================================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =====================================================================
# CORREO
# =====================================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =====================================================================
# AWS (opcional)
# =====================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =====================================================================
# VITE
# =====================================================================

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# DESARROLLO
# =====================================================================

# Omitir verificación SSL de DolarAPI solo si es necesario en desarrollo.
# No recomendado para producción.
DOLARAPI_SKIP_SSL_VERIFY=false