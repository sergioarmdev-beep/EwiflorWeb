APP_NAME=EwiflorWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# --- Base de datos: conexión de la aplicación (DML) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE="Ewiflor_DB_MVP"
DB_USERNAME=ewiflor_app
DB_PASSWORD=

# --- Base de datos: conexión de migración (DDL) (D1) ---
DB_MIGRATOR_CONNECTION=pgsql_migrator
DB_MIGRATOR_HOST=127.0.0.1
DB_MIGRATOR_PORT=5432
DB_MIGRATOR_DATABASE="Ewiflor_DB_MVP"
DB_MIGRATOR_USERNAME=ewiflor_migrator
DB_MIGRATOR_PASSWORD=

# --- Drivers (D3): file/sync para arrancar ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Hash (CRÍTICO) ---
# Debe ser bcrypt: el CHECK de usuario.contrasena_hash solo acepta $2[aby]$
HASH_DRIVER=bcrypt
HASH_BCRYPT_ROUNDS=12

# --- Auth ---
AUTH_GUARD=web
AUTH_MODEL=App\Models\User

# --- Logs ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

VITE_APP_NAME="${APP_NAME}"
